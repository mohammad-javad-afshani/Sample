{
  "ConnectionStrings": {
    "DefaultConnection": "server=(LocalDb)\\MSSQLLocalDB;database=SampleMainDb;trusted_connection=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ProductApi": {
    "AdminApiKey": "change-me-in-production",
    "DiscountRate": 0.73
  },
  "PaymentGateway": {
    "BaseUrl": "https://payments.example.local/",
    "TimeoutSeconds": 30
  },
  "Webhooks": {
    "BaseUrl": "https://hooks.example.local/",
    "TimeoutSeconds": 10,
    "SigningKey": "configure-via-secrets-or-environment"
  },
  "RefundGateway": {
    "BaseUrl": "https://refunds.example.local/",
    "TimeoutSeconds": 15
  }
}
